; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="编趣 Quaver"
config/description="纯电脑键盘弹奏 + 鼠标编曲的桌面端纯音乐工具（无外设依赖）"
config/version="1.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
config/icon="res://assets/sprites/icon64.png"

[autoload]

InstrumentBank="*res://scripts/instrument_bank.gd"
Synth="*res://scripts/synth_engine.gd"
Theory="*res://scripts/theory_engine.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1024
window/size/min_height=640

[editor_plugins]

enabled=PackedStringArray("res://addons/gode/plugin.cfg")

[gui]

theme/custom_font_size=14

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
