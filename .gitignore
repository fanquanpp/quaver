# ── Godot 引擎 ──────────────────────────────────────────────
# 导入缓存（自动重建）
.godot/
.import/
# Android 导出模板生成目录
/android/
# 本地化构建产物
*.translation

# ── gode 插件（体积原因不入库；安装步骤见 README「可选：TypeScript 乐理后端」）──
/addons/gode/
# gode TypeScript 编译缓存
/.gode/

# ── 构建产物（export_presets.cfg 已入库，保证发布可复现）────────
/build/
/export/
*.pck
*.exe
*.zip

# ── 系统 / IDE ─────────────────────────────────────────────
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp
*.bak
*.tmp

# 诊断脚本现场产物（见 tools/diag_overlay.ps1）
tools/diag_result/

# ── Godot 本地敏感/覆盖文件 ────────────────────────────────────
# 编辑器本地覆盖（窗口位置等，不入库）
override.ini
# 导出凭据（密钥/签名配置，绝不入库）
export_credentials.cfg

# ── 其他工具链 ──────────────────────────────────────────────
# TS 依赖（gode 自带运行时，一般用不到）
node_modules/
# 日志
*.log
